# =============================================================================
# Foundry Learn Agent - environment template
# Author : dcodev1702 & M365 Copilot / Cowork
# Created: 2026-09-28
#
#   cp .env.example .env        # then put your OpenAI API key below; .env is git- and docker-ignored
#
# Docker Compose passes .env to the api container (env_file in compose.yaml). A local `uvicorn` run does not
# read this file - export the same variables in your shell instead. Keep values unquoted and comments on their
# own lines: Compose would treat trailing text as part of the value.
# =============================================================================

# Required - the app refuses to start without it.
OPENAI_API_KEY=

# Optional - uncomment to override; the values shown are the defaults.
# OPENAI_MODEL=gpt-5.6-luna
# OTEL_SERVICE_NAME=foundry-learn-agent
# HEALTHZ_INTERVAL_SECONDS=60
# OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=docs,openapi.json,redoc,healthz
# LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# Read by the OpenTelemetry SDK and instrumentation, not by app.py.
# Milliseconds between span flushes (SDK default 5000); 1000 makes the console feel snappier.
# OTEL_BSP_SCHEDULE_DELAY=1000
# Switch auto-instrumented spans to the newer HTTP attribute names.
# OTEL_SEMCONV_STABILITY_OPT_IN=http

# OTEL_EXPORTER_OTLP_ENDPOINT is deliberately not listed: unset means console spans, and compose.jaeger.yaml
# sets it to http://jaeger:4318 for Jaeger mode.

# Step 4 only - the Azure Monitor block in app.py, commented out by default.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
