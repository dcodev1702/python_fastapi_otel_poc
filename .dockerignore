# Keep secrets and clutter out of the Docker build context (only requirements/ and app.py are COPY'd anyway)
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc
.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.md
compose*.yaml
Dockerfile
# development only: tests, tooling, CI
tests/
scripts/
.github/
Makefile
pytest.ini
requirements/dev.txt
